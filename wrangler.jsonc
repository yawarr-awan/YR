{
  // Worker name MUST match the Worker you create in the Cloudflare dashboard,
  // or Workers Builds will refuse to deploy.
  "name": "yr-wellness",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",

  // Serve the repo root as static assets. .assetsignore keeps the
  // build files out of the published site.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yr-wellness-sync",
      "database_id": "263a6c10-78f5-431a-9f2b-3e399a017a8f"
    }
  ],

  // ACCESS_TEAM_DOMAIN, ACCESS_AUD, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
  // and GEMINI_API_KEY are all set as SECRETS in the dashboard, not vars.
  // Plain vars declared here would overwrite the dashboard values on every
  // deploy; secrets persist across deploys.

  // Fires at one minute past every hour; the scheduled handler itself only
  // acts during the midnight Europe/London hour (BRIEF_HOUR, computed via
  // Intl so it tracks BST/GMT with no DST table to maintain here) and
  // dedupes against D1, so this stays a once-a-day 00:01 brief despite the
  // hourly trigger. Cron alone cannot express it: cron is evaluated in UTC
  // and London is an hour off UTC for half the year.
  "triggers": { "crons": ["1 * * * *"] },

  "observability": { "enabled": true }
}
