{
  // Worker name MUST match the Worker you create in the Cloudflare dashboard,
  // or Workers Builds will refuse to deploy.
  "name": "yr-wellness",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",

  // Serve the repo root as static assets. .assetsignore keeps the
  // build files out of the published site.
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yr-wellness-sync",
      "database_id": "263a6c10-78f5-431a-9f2b-3e399a017a8f"
    }
  ],

  // ACCESS_TEAM_DOMAIN and ACCESS_AUD are set as SECRETS in the dashboard,
  // not vars. Plain vars declared here would overwrite the dashboard values
  // on every deploy; secrets persist across deploys.

  "observability": { "enabled": true }
}
